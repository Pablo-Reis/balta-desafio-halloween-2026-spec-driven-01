<UserControl x:Class="Productivity.App.Controls.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="8" Height="8" IsHitTestVisible="False" VerticalAlignment="Center">
    <Grid>
        <Ellipse x:Name="Halo" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Core" />
    </Grid>
</UserControl>
