<Window x:Class="Productivity.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:Productivity.App.Controls"
        Title="Monitor de produtividade" Width="1200" Height="820" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Aurora.Text}"
        StateChanged="OnStateChanged" Closing="OnClosing" Activated="OnActivated" SizeChanged="OnSizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="66" ResizeBorderThickness="8" GlassFrameThickness="0"
                            CornerRadius="28" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <!-- Manchas de cor à deriva atrás do vidro (20-30 s em loop) -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard Timeline.DesiredFrameRate="30" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Blob1Move" Storyboard.TargetProperty="X" From="0" To="120" Duration="0:0:11" />
                    <DoubleAnimation Storyboard.TargetName="Blob1Move" Storyboard.TargetProperty="Y" From="0" To="60" Duration="0:0:11" />
                    <DoubleAnimation Storyboard.TargetName="Blob2Move" Storyboard.TargetProperty="X" From="0" To="-140" Duration="0:0:13" />
                    <DoubleAnimation Storyboard.TargetName="Blob2Move" Storyboard.TargetProperty="Y" From="0" To="-40" Duration="0:0:13" />
                    <DoubleAnimation Storyboard.TargetName="Blob3Move" Storyboard.TargetProperty="X" From="0" To="60" Duration="0:0:15" />
                    <DoubleAnimation Storyboard.TargetName="Blob3Move" Storyboard.TargetProperty="Y" From="0" To="-90" Duration="0:0:15" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="Root" Margin="14">
        <!-- Base opaca + sombra (separada do conteúdo animado) -->
        <Border x:Name="Backdrop" CornerRadius="28" Background="{DynamicResource Aurora.WindowBase}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Glass">
            <!-- Manchas Aurora -->
            <Grid IsHitTestVisible="False">
                <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-160,0,0"
                         Opacity="{DynamicResource Aurora.Blob1Opacity}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF7C3AED" Offset="0" />
                            <GradientStop Color="#997C3AED" Offset="0.4" />
                            <GradientStop Color="#337C3AED" Offset="0.72" />
                            <GradientStop Color="#007C3AED" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob1Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,-140,0"
                         Opacity="{DynamicResource Aurora.Blob2Opacity}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF0891B2" Offset="0" />
                            <GradientStop Color="#990891B2" Offset="0.4" />
                            <GradientStop Color="#330891B2" Offset="0.72" />
                            <GradientStop Color="#000891B2" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob2Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="80,0,0,-220"
                         Opacity="{DynamicResource Aurora.Blob3Opacity}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFDB2777" Offset="0" />
                            <GradientStop Color="#99DB2777" Offset="0.4" />
                            <GradientStop Color="#33DB2777" Offset="0.72" />
                            <GradientStop Color="#00DB2777" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob3Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Vidro: véu translúcido + borda de 1px -->
            <Border x:Name="GlassTint" CornerRadius="28" Background="{DynamicResource Aurora.WindowTint}"
                    BorderBrush="{DynamicResource Aurora.WindowBorder}" BorderThickness="1" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra de título própria -->
                <Grid Margin="22,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="9" Background="{StaticResource Aurora.Accent}">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" Opacity="0.45" BlurRadius="18" ShadowDepth="6" Direction="270" />
                            </Border.Effect>
                            <ctl:Icon Data="{StaticResource Icon.Clock}" Width="15" Height="15" Foreground="White" StrokeWidth="2.2" />
                        </Border>
                        <TextBlock Text="Produtividade" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Aurora.Text}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="Minimizar" Click="OnMinimizeClick">
                            <ctl:Icon Data="{StaticResource Icon.Minimize}" Width="12" Height="12" StrokeWidth="2.4" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="6,0,0,0"
                                AutomationProperties.Name="Maximizar" Click="OnMaximizeClick">
                            <ctl:Icon Data="{StaticResource Icon.Maximize}" Width="11" Height="11" StrokeWidth="2.4" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="6,0,0,0"
                                AutomationProperties.Name="Fechar" Click="OnCloseClick">
                            <ctl:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" StrokeWidth="2.4" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="18,6,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Barra lateral em vidro -->
                    <Border CornerRadius="22" Padding="14" Background="{DynamicResource Aurora.Sidebar}"
                            BorderBrush="{DynamicResource Aurora.SidebarBorder}" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" CornerRadius="16" Padding="14" Background="{DynamicResource Aurora.SidebarInner}"
                                    BorderBrush="{DynamicResource Aurora.SidebarBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ATALHOS" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Iniciar" FontSize="12" Foreground="{DynamicResource Aurora.TextNav}" VerticalAlignment="Center" Margin="0,4" />
                                        <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="0,4"><TextBlock x:Name="KeyStart" FontSize="11" Foreground="{DynamicResource Aurora.Text}" /></Border>
                                        <TextBlock Grid.Row="1" Text="Pausar" FontSize="12" Foreground="{DynamicResource Aurora.TextNav}" VerticalAlignment="Center" Margin="0,4" />
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Chip}" Margin="0,4"><TextBlock x:Name="KeyPause" FontSize="11" Foreground="{DynamicResource Aurora.Text}" /></Border>
                                        <TextBlock Grid.Row="2" Text="Finalizar" FontSize="12" Foreground="{DynamicResource Aurora.TextNav}" VerticalAlignment="Center" Margin="0,4" />
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Chip}" Margin="0,4"><TextBlock x:Name="KeyFinish" FontSize="11" Foreground="{DynamicResource Aurora.Text}" /></Border>
                                        <TextBlock Grid.Row="3" Text="Anotar" FontSize="12" Foreground="{DynamicResource Aurora.TextNav}" VerticalAlignment="Center" Margin="0,4" />
                                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Chip}" Margin="0,4"><TextBlock x:Name="KeyNote" FontSize="11" Foreground="{DynamicResource Aurora.Text}" /></Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="Nav" Style="{StaticResource PlainList}" SelectionChanged="OnNavChanged"
                                     VerticalAlignment="Top" AutomationProperties.Name="Navegação principal">
                                <ListBoxItem Content="Painel" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.Dashboard}" />
                                <ListBoxItem Content="Demandas" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.List}" />
                                <ListBoxItem Content="Configurações" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.Sliders}" />
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ContentControl x:Name="Host" Grid.Column="2" IsTabStop="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
