<Window x:Class="Productivity.App.Windows.NoteSpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anotação" Width="680" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Loaded="OnLoaded" Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Border CornerRadius="24" Padding="24,20"
                Background="{DynamicResource Aurora.WindowBase}"
                BorderBrush="{DynamicResource Aurora.ButtonGlassBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="ContextText" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                           TextTrimming="CharacterEllipsis" />
                <Grid>
                    <TextBox x:Name="NoteBox" FontSize="24" BorderThickness="0" Background="Transparent"
                             Padding="2,6" MaxLength="2000" AcceptsReturn="False" TextChanged="OnTextChanged" />
                    <TextBlock x:Name="Placeholder" Text="Escreva uma anotação…" FontSize="24" IsHitTestVisible="False"
                               Style="{StaticResource Muted}" Opacity="0.6" Margin="8,6,0,0" />
                </Grid>
                <TextBlock Text="Enter para salvar  ·  Esc para cancelar" Style="{StaticResource Muted}" FontSize="12"
                           Margin="2,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

