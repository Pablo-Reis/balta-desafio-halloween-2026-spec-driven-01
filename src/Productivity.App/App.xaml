<Application x:Class="Productivity.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- A paleta (escura/clara) é trocada em tempo de execução por AuroraTheme -->
                <ResourceDictionary Source="Styles/Aurora.Palette.Dark.xaml" />
                <ResourceDictionary Source="Styles/Aurora.Icons.xaml" />
                <ResourceDictionary Source="Styles/Aurora.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
