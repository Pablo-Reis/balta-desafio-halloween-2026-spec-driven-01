<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Productivity.App.Controls">

    <!-- Acento "Aurora": #8B5CF6 -> #22D3EE -->
    <Color x:Key="Aurora.VioletColor">#8B5CF6</Color>
    <Color x:Key="Aurora.CyanColor">#22D3EE</Color>

    <LinearGradientBrush x:Key="Aurora.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Aurora.AccentVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Aurora.AccentSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#618B5CF6" Offset="0" />
        <GradientStop Color="#3822D3EE" Offset="1" />
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="RunningBrush" Color="#34D399" />
    <SolidColorBrush x:Key="PausedBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="RunningBg" Color="#1F34D399" />
    <SolidColorBrush x:Key="RunningBorder" Color="#4734D399" />
    <SolidColorBrush x:Key="PausedBg" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="PausedBorder" Color="#47FBBF24" />

    <!-- Texto -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.TextSecondary}" />
    </Style>

    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.TextSecondary}" />
    </Style>

    <Style x:Key="Timer" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Display, Segoe UI Light" />
        <Setter Property="FontWeight" Value="ExtraLight" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
    </Style>

    <!-- Cartões de vidro -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Glass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SessionCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource Aurora.GlassStrong}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="28,26" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Chip}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <!-- Botão sem aparência (usado pela pílula do balão) -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de vidro -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
        <Setter Property="Background" Value="{DynamicResource Aurora.ButtonGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.ButtonGlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Press" />
                                <TranslateTransform x:Name="Lift" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" />
                        <Border x:Name="Glow" CornerRadius="14" Background="{DynamicResource Aurora.HoverOverlay}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão principal em degradê com brilho -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Press" />
                                <TranslateTransform x:Name="Lift" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border CornerRadius="14" Background="{StaticResource Aurora.Accent}">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" Opacity="0.45" BlurRadius="24" ShadowDepth="8" Direction="270" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Glow" CornerRadius="14" Background="White" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões da janela (minimizar, maximizar, fechar): 30px translúcidos -->
    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.TextNav}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Aurora.WinButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Aurora.WinButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pílula de vidro (ex.: "Nova demanda") -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Press" />
                                <TranslateTransform x:Name="Lift" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border CornerRadius="999" Background="{DynamicResource Aurora.ButtonGlass}"
                                BorderBrush="{DynamicResource Aurora.ButtonGlassBorder}" BorderThickness="1" />
                        <Border x:Name="Glow" CornerRadius="999" Background="{DynamicResource Aurora.HoverOverlay}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista simples sem moldura -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item da navegação lateral: ícone + texto, ativo com degradê e brilho -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.TextNav}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" MinHeight="44" Margin="0,2" Padding="14,0" CornerRadius="14" BorderThickness="1"
                            BorderBrush="Transparent" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Icon Data="{TemplateBinding Tag}" Width="18" Height="18" Margin="0,0,12,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Aurora.NavHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Aurora.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Aurora.ButtonGlassBorder}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#8B5CF6" Opacity="0.25" BlurRadius="24" ShadowDepth="8" Direction="270" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item da lista de demandas -->
    <Style x:Key="DemandItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Margin="0,0,0,6" Padding="12,8" CornerRadius="14" BorderThickness="1"
                            Background="{DynamicResource Aurora.Glass}" BorderBrush="{DynamicResource Aurora.GlassBorder}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Aurora.GlassHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Aurora.GlassBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Aurora.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Aurora.ButtonGlassBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de progresso em degradê (Foreground define o gradiente) -->
    <Style x:Key="GradientBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Aurora.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="999" Background="{DynamicResource Aurora.BarEmpty}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="999" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
