    <SolidColorBrush x:Key="Aurora.WinButtonHover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Aurora.NavHover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Aurora.BarEmpty" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Aurora.RingTrack" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Aurora.Island" Color="#E0121220" />
    <SolidColorBrush x:Key="Aurora.IslandBorder" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Aurora.HoverOverlay" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="Aurora.TimeText" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="#FFFFFF" Offset="0.3" />
        <GradientStop Color="#A5F3FC" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Aurora.Blob1Opacity">0.55</sys:Double>
    <sys:Double x:Key="Aurora.Blob2Opacity">0.45</sys:Double>
    <sys:Double x:Key="Aurora.Blob3Opacity">0.40</sys:Double>
</ResourceDictionary>
