<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Paleta Aurora - tema escuro -->
    <SolidColorBrush x:Key="Aurora.Text" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Aurora.TextNav" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="Aurora.TextSecondary" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="Aurora.TextMuted" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="Aurora.WindowBase" Color="#F00A0A12" />
    <SolidColorBrush x:Key="Aurora.WindowTint" Color="#7A161622" />
    <SolidColorBrush x:Key="Aurora.WindowBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Aurora.Glass" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Aurora.GlassStrong" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="Aurora.GlassHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Aurora.GlassBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Aurora.GlassBorderHover" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Aurora.Sidebar" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Aurora.SidebarBorder" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Aurora.SidebarInner" Color="#2E000000" />
