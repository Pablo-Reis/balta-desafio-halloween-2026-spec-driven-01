<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ProductivityMonitor.Setup</AssemblyName>
    <RootNamespace>Productivity.Installer</RootNamespace>
    <ApplicationIcon>Assets\setup.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInId>false</IncludeSourceRevisionInId>
    <Product>Monitor de produtividade</Product>
    <AssemblyTitle>Instalador do Monitor de produtividade</AssemblyTitle>
    <!-- Pacote do programa (.zip) embutido no executável; gerado por installer\package.ps1 -->
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildProjectDirectory)\obj\payload\app.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Productivity.Setup.Core\Productivity.Setup.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
